NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=edutrack
DB_PASSWORD=edutrack
DB_DATABASE=edutrack
DB_SCHEMA=public
DB_SSL=false
DB_LOGGING=false

# JWT
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-refresh-secret
JWT_REFRESH_TTL=7d
JWT_ISSUER=edutrack
JWT_AUDIENCE=edutrack-api

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Logging
LOG_LEVEL=info
